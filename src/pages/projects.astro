---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    number: "01",
    title: "Personal site",
    description: "A calm, fast home for my writing and experiments. Built with Astro, TypeScript, and Markdown.",
    status: "You are here",
  },
  {
    number: "02",
    title: "A project to be named",
    description: "This is a placeholder for the next small thing worth making. Replace it with something you’re proud of.",
    status: "In progress",
  },
  {
    number: "03",
    title: "Open space",
    description: "A future experiment, collaboration, or tool that earns its place here.",
    status: "The idea is forming",
  },
];
---

<BaseLayout title="Projects — Fajar" description="A selection of projects and experiments by Fajar.">
  <section class="page-intro container">
    <p class="eyebrow">Projects</p>
    <h1>Things I’ve<br /><em>made.</em></h1>
    <p class="lede">A short list is better than a long one. These are the things that have made it out of my head and into the world.</p>
  </section>

  <section class="project-archive container section-border">
    {projects.map((project) => (
      <article class="project-card">
        <div class="project-card-number">{project.number}</div>
        <div class="project-card-copy">
          <p class="eyebrow">{project.status}</p>
          <h2>{project.title}</h2>
          <p>{project.description}</p>
        </div>
        <span class="project-card-mark" aria-hidden="true">↗</span>
      </article>
    ))}
  </section>

  <section class="closing-cta container">
    <p class="eyebrow">A good project starts small</p>
    <h2>What should I<br /><em>make next?</em></h2>
    <a class="text-link" href="mailto:hello@example.com">Tell me <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
