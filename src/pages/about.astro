---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — Fajar" description="A little more about Fajar.">
  <section class="page-intro container">
    <p class="eyebrow">About</p>
    <h1>A work in<br /><em>progress.</em></h1>
    <p class="lede">A place to collect the ideas, projects, and questions I keep coming back to.</p>
  </section>

  <section class="content-section container narrow-container section-border">
    <div class="prose">
      <p class="dropcap">I’m Fajar. I like making useful things, following interesting questions, and writing down what I learn along the way.</p>
      <p>This site is intentionally small. There’s no polished personal brand hiding behind it — just a living record of the work, experiments, and notes I want to remember.</p>
      <p>Over time, this page will become a better answer to the question “what are you up to?” For now, the best place to look is the <a href="/projects/">projects page</a> or the <a href="/blog/">writing archive</a>.</p>
    </div>
  </section>

  <section class="section container section-border info-grid">
    <div>
      <p class="eyebrow">Currently</p>
      <p>Learning in public<br />Making small bets<br />Keeping notes</p>
    </div>
    <div>
      <p class="eyebrow">Elsewhere</p>
      <p><a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a><br /><a href="mailto:hello@example.com">Email ↗</a></p>
    </div>
  </section>
</BaseLayout>
