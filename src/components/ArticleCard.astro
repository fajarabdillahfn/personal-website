---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const formattedDate = post.data.publishedAt.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article class:list={["article-card", { featured }]}>
  <div class="article-card-topline">
    <span class:list={["note-status", `status-${post.data.status}`]}>{post.data.status}</span>
    <time datetime={post.data.publishedAt.toISOString()}>{formattedDate}</time>
  </div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="article-card-meta">
    <span>{post.data.tags.join(" · ") || "Notes"}</span>
    {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
  </div>
  <a class="text-link" href={`/blog/${post.id}/`}>Read note <span aria-hidden="true">↗</span></a>
</article>
